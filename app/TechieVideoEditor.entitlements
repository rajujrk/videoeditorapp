<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the app may do under the hardened runtime (a Developer ID signature, needed for
     Apple's notarization; tools/make_dmg.sh). The app is not sandboxed. -->
<plist version="1.0">
<dict>
	<!-- QML's JavaScript compiler writes the code it runs. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Audio Units, VST3 and OpenFX plug-ins installed on the Mac are signed by their makers,
	     not by this app's team. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Voice-overs and screen recordings with sound; the camera beside a screen recording. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Importing from Photos, and adding Live Photos to it. -->
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
</dict>
</plist>
