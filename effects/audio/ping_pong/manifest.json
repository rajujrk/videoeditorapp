    {"id": "level", "type": "float", "title": {"en": "Level"}, "min": 0, "max": 1, "default": 0.5}
  ],
  "chain": [
    {"processor": "delay", "settings": {"pingPong": 1, "tone": 0.7}}
  ],
  "license": "TVE-Original"
}
