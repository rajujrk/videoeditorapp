{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "techievideoeditor",
  "version": "0.0.1",
  "description": "TechieVideoEditor desktop video editor",
  "builtin-baseline": "0e5030f583a5427123cd3b714255e5ae62faa3ba",
  "dependencies": [
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swscale",
        "swresample"
      ]
    },
    "nlohmann-json",
    "catch2",
    "miniaudio",
    "thorvg",
    {
      "name": "ggml",
      "default-features": false,
      "features": [
        "metal"
      ]
    },
    "whisper-cpp",
    "rnnoise",
    "onnxruntime"
  ],
  "vcpkg-configuration": {
    "overlay-ports": [
      "./cmake/ports"
    ]
  },
  "overrides": [
    {
      "name": "abseil",
      "version": "20260107.1",
      "port-version": 3
    },
    {
      "name": "boost-config",
      "version": "1.92.0"
    },
    {
      "name": "boost-mp11",
      "version": "1.92.0"
    },
    {
      "name": "flatbuffers",
      "version": "25.12.19"
    },
    {
      "name": "ms-gsl",
      "version": "4.2.2"
    },
    {
      "name": "onnx",
      "version": "1.22.0"
    },
    {
      "name": "protobuf",
      "version": "7.36.2"
    }
  ]
}
